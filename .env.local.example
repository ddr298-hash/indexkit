# 진단할 기본 네이버 블로그 ID (blog.naver.com/이 부분). 실행 시 인자로 덮어쓸 수 있습니다.
NAVER_BLOG_ID=

# Google Custom Search JSON API
# https://console.cloud.google.com 에서 "Custom Search API" 사용 설정 후 발급
GOOGLE_CSE_API_KEY=

# https://programmablesearchengine.google.com 에서 검색엔진 생성 시
# "전체 웹 검색"을 켜고 발급되는 검색엔진 ID (cx)
GOOGLE_CSE_ID=

# Google Indexing API용 서비스 계정 키 파일(JSON) 경로
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-credentials.json
